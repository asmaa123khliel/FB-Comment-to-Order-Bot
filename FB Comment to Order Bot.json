    {
      "parameters": {
        "jsCode": "// ============================================================\n// Parse Events — بيستقبل 3 مصادر:\n//  1) Webhook (feed / messaging) — خطة احتياطية لو التطبيق بقى Live\n//  2) Fetch Comments — polling كومنتات كل دقيقة\n//  3) Fetch Conversations — polling رسايل الماسنجر كل دقيقة\n// ============================================================\nconst PAGE_ID = '550829251444940';\n\nconst staticData = $getWorkflowStaticData('global');\nconst processedComments = new Set(staticData.processedComments || []);\nconst processedMessages = new Set(staticData.processedMessages || []);\nconst seen = new Set();\n\nconst pendingComments = [];\nconst pendingMessages = []; // { event, ids: [] }\nlet sawPosts = false;\nlet sawConversations = false;\n\nfunction addComment(ev) {\n  if (!ev.comment_id) return;\n  if (seen.has(ev.comment_id) || processedComments.has(ev.comment_id)) return;\n  seen.add(ev.comment_id);\n  pendingComments.push(ev);\n}\n\nfunction addMessage(ev, ids) {\n  const list = ids || [ev.message_id];\n  if (!ev.message_id) return;\n  if (list.some((id) => seen.has(id) || processedMessages.has(id))) return;\n  for (const id of list) seen.add(id);\n  pendingMessages.push({ event: ev, ids: list });\n}\n\nconst items = $input.all().map((i) => i.json || {});\n\nfor (const j of items) {\n  // ---------- 1) Webhook ----------\n  const body = j.body || {};\n  for (const entry of body.entry || []) {\n    const pageId = entry.id || PAGE_ID;\n    for (const ch of entry.changes || []) {\n      const v = ch.value || {};\n      if (ch.field === 'feed' && v.item === 'comment' && v.verb === 'add') {\n        if (v.from && v.from.id === pageId) continue;\n        if (v.parent_id && v.parent_id !== v.post_id) continue;\n        addComment({\n          type: 'comment', page_id: pageId, comment_id: v.comment_id, post_id: v.post_id,\n          from_id: (v.from && v.from.id) || '', from_name: (v.from && v.from.name) || '',\n          text: v.message || '',\n        });\n      }\n    }\n    for (const m of entry.messaging || []) {\n      if (!m.message || m.message.is_echo || !m.sender || m.sender.id === pageId) continue;\n      addMessage({\n        type: 'message', page_id: pageId, user_id: m.sender.id,\n        message_id: m.message.mid || 'wh_' + m.sender.id + '_' + (m.timestamp || Date.now()),\n        text: m.message.text || '[العميل بعت مرفق أو صورة]',\n        created_time: new Date(m.timestamp || Date.now()).toISOString(),\n      });\n    }\n  }\n\n  // ---------- 2) Graph API polling ----------\n  const arr = Array.isArray(j.data) ? j.data : [];\n  if (!arr.length) continue;\n\n  const isConversations = arr.some((x) => x && x.messages);\n  if (isConversations) {\n    sawConversations = true;\n    for (const conv of arr) {\n      const msgs = (conv.messages && conv.messages.data) || [];\n      const fresh = msgs.filter((m) => {\n        const f = (m.from && m.from.id) || '';\n        return f && f !== PAGE_ID && m.id && !processedMessages.has(m.id) && !seen.has(m.id);\n      });\n      if (!fresh.length) continue;\n      fresh.sort((a, b) => String(a.created_time).localeCompare(String(b.created_time)));\n\n      const firstRun = !staticData.pollMessagesInitialized;\n      // أول تشغيل: نرد على أحدث رسالة بس (عشان مفيش سبام لرسايل قديمة)\n      const toReply = firstRun ? fresh.slice(-1) : fresh;\n      const last = toReply[toReply.length - 1];\n      const ageHours = (Date.now() - new Date(last.created_time).getTime()) / 3600000;\n\n      if (ageHours > 23.5) {\n        for (const m of fresh) { processedMessages.add(m.id); seen.add(m.id); }\n        continue;\n      }\n\n      const text = toReply.map((m) => m.message || '[العميل بعت مرفق أو صورة]').join('\\n');\n      addMessage(\n        {\n          type: 'message', page_id: PAGE_ID, user_id: last.from.id,\n          message_id: last.id, text, created_time: last.created_time,\n        },\n        fresh.map((m) => m.id),\n      );\n    }\n  } else {\n    sawPosts = true;\n    for (const post of arr) {\n      const postId = post.id;\n      const pageId = String(postId).split('_')[0];\n      const comments = (post.comments && post.comments.data) || [];\n      for (const c of comments) {\n        const fromId = (c.from && c.from.id) || '';\n        if (fromId && fromId === pageId) continue;\n        addComment({\n          type: 'comment', page_id: pageId, comment_id: c.id, post_id: postId,\n          from_id: fromId, from_name: (c.from && c.from.name) || '', text: c.message || '',\n        });\n      }\n    }\n  }\n}\n\n// ---------- أول تشغيل للكومنتات: سجّل القديم من غير رد ----------\nif (sawPosts && !staticData.pollInitialized) {\n  staticData.pollInitialized = true;\n  for (const c of pendingComments) processedComments.add(c.comment_id);\n  pendingComments.length = 0;\n}\nif (sawConversations && !staticData.pollMessagesInitialized) {\n  staticData.pollMessagesInitialized = true;\n}\n\n// ---------- رسالة واحدة كل دورة (عشان الـ AI Agent يشتغل صح) ----------\nconst messagesToRun = pendingMessages.slice(0, 1);\n\n// ---------- سجّل اللي اتعالج ----------\nfor (const c of pendingComments) processedComments.add(c.comment_id);\nfor (const m of messagesToRun) for (const id of m.ids) processedMessages.add(id);\n\nstaticData.processedComments = [...processedComments].slice(-500);\nstaticData.processedMessages = [...processedMessages].slice(-500);\n\n// الرسايل الزيادة (pendingMessages.slice(1)) مش بنسجلها → هتظهر تاني في الدورة الجاية\nreturn [\n  ...pendingComments.map((json) => ({ json })),\n  ...messagesToRun.map((m) => ({ json: m.event })),\n];\n"
      },
