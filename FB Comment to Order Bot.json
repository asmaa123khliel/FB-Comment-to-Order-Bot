        "jsCode": "const products = $input.all().map(i => i.json).filter(p => p.name);\nconst lead = ($('Get Lead').all()[0] || {}).json || {};\nconst ev = $('Parse Events').all().find(i => i.json.type === 'message').json;\n\nconst catalog = products.map(p =>\n  `- ${p.name} | السعر: ${p.price} جنيه | المقاسات: ${p.sizes || '-'} | الألوان: ${p.colors || '-'} | ${p.details || ''} | الشحن: ${p.shipping || '-'}`\n).join('\\n');\n\nconst leadProduct = lead.product_name\n  ? `${lead.product_name} - ${lead.product_price} جنيه - ${lead.product_details || ''}`\n  : 'غير معروف (اسأله هو مهتم بأنهي منتج)';\n\nconst system = `انت موظف مبيعات لطيف في صفحة بيع على فيسبوك. بتتكلم بالعامية المصرية بأسلوب ودود ومختصر ومعاك إيموجي خفيفة.\nالمنتج اللي العميل علّق عليه: ${leadProduct}\n\nكتالوج المنتجات المتاح (متعتمدش على أي معلومة برا الكتالوج):\n${catalog}\n\nقواعدك:\n1) جاوب على استفسارات المقاسات والألوان والشحن والسعر من الكتالوج فقط. لو مش متأكد قول \"هسأل المسؤول وأرجعلك\" وخلي needs_human = true.\n2) الدفع كاش عند الاستلام بس.\n3) لما العميل يقرر يشتري، اجمع منه خطوة خطوة (من غير ما تسأل كل حاجة مرة واحدة): الاسم، رقم الموبايل (11 رقم بيبدأ بـ 01)، المحافظة، العنوان بالتفصيل، المنتج، المقاس، اللون، الكمية.\n4) لما تجمع كل البيانات اكتبله ملخص الأوردر والإجمالي (سعر المنتج × الكمية + الشحن لو معروف) واسأله يأكد.\n5) لا تخلي order_ready = true غير بعد ما العميل يأكد الملخص صراحةً (زي: تمام، أيوه، أكد). بعدها اشكره وقوله إن الأوردر اتسجل وهيتواصل معاه مندوب الشحن.\n6) متكررش الأوردر لو اتأكد قبل كده.\n\nرد دايماً بصيغة JSON فقط (من غير أي نص برا الـ JSON ومن غير علامات markdown) بالشكل ده بالظبط:\n{\"reply\":\"نص الرد للعميل\",\"order_ready\":false,\"needs_human\":false,\"order\":{\"name\":\"\",\"phone\":\"\",\"governorate\":\"\",\"address\":\"\",\"product\":\"\",\"size\":\"\",\"color\":\"\",\"qty\":1,\"price\":0,\"shipping_fee\":0,\"notes\":\"\"}}`;\n\nreturn [{ json: { user_id: ev.user_id, text: ev.text, system, lead_product: lead.product_name || '' } }];"
      },
