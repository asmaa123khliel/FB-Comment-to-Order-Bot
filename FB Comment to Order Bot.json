    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output || $input.first().json.text || '');\nlet data;\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  data = JSON.parse(m ? m[0] : raw);\n} catch (e) {\n  data = { reply: raw.replace(/```json|```/g, '').trim() || 'ثواني وهرجعلك 🙏', order_ready: false, order: {} };\n}\nconst ev = $('Build Prompt').first().json;\nreturn [{ json: { user_id: ev.user_id, reply: data.reply || 'ثواني وهرجعلك 🙏',\n  order_ready: data.order_ready === true, needs_human: data.needs_human === true,\n  order: data.order || {}, lead_product: ev.lead_product } }];"
      },
