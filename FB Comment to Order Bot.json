    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ev = $('Parse Events').item.json;\nconst p = $json || {};\nconst first = (ev.from_name || '').split(' ')[0] || 'حضرتك';\nconst replies = [\n  'أهلاً بيك يا فندم 🌹 بعتنالك التفاصيل والأسعار على الخاص',\n  'تحت أمرك 🌸 دخلنا لحضرتك على الخاص بكل التفاصيل',\n  'نورتنا ❤️ راجع رسايل الخاص فيها كل التفاصيل والسعر'\n];\nconst comment_reply = replies[Math.floor(Math.random() * replies.length)];\nlet dm;\nif (p.name) {\n  dm = [\n    `أهلاً ${first} 🌹`,\n    `شكراً لاهتمامك بـ ${p.name}`,\n    ``,\n    `💰 السعر: ${p.price} جنيه`,\n    p.sizes ? `📏 المقاسات: ${p.sizes}` : null,\n    p.colors ? `🎨 الألوان: ${p.colors}` : null,\n    p.details ? `📝 ${p.details}` : null,\n    p.shipping ? `🚚 الشحن: ${/^\\d+(\\.\\d+)?$/.test(String(p.shipping).trim()) ? String(p.shipping).trim() + \" جنيه\" : p.shipping}` : null,\n    `💵 الدفع عند الاستلام`,\n    ``,\n    `لو حابب تحجز ابعتلي المقاس واللون وأنا أكمل معاك 👇`\n  ].filter(x => x !== null).join('\\n');\n} else {\n  dm = `أهلاً ${first} 🌹\\nشكراً لتعليقك! قولي حضرتك مهتم بأنهي منتج وأنا أبعتلك التفاصيل والسعر 👇`;\n}\nconst product_details = [\n  p.sizes && `المقاسات: ${p.sizes}`, p.colors && `الألوان: ${p.colors}`,\n  p.details, p.shipping && `الشحن: ${p.shipping}`\n].filter(Boolean).join(' | ');\nreturn { json: { comment_id: ev.comment_id, user_id: ev.from_id, post_id: ev.post_id,\n  comment_reply, dm_text: dm, product_name: p.name || '', product_price: p.price || '', product_details } };"
      },
