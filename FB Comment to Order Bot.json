    {
      "parameters": {
        "jsCode": "const out = [];\nconst comments = $('Build Comment Reply').all();\n$input.all().forEach((item, i) => {\n  const rid = item.json.recipient_id;\n  if (!rid) return; // الرسالة الخاصة فشلت\n  const c = comments[i].json;\n  out.push({ json: { user_id: rid, post_id: c.post_id, product_name: c.product_name,\n    product_price: c.product_price, product_details: c.product_details,\n    date: new Date().toISOString() } });\n});\nreturn out;"
