    {
      "parameters": {
        "jsCode": "const d = $('Parse Agent Output').first().json;\nconst o = d.order || {};\nconst qty = Number(o.qty) || 1;\nconst price = Number(o.price) || 0;\nconst ship = Number(o.shipping_fee) || 0;\nreturn [{ json: {\n  date: new Date().toLocaleString('en-GB', { timeZone: 'Africa/Cairo' }),\n  order_id: 'ORD-' + Date.now().toString().slice(-7),\n  name: o.name || '', phone: o.phone || '', governorate: o.governorate || '', address: o.address || '',\n  product: o.product || d.lead_product || '', size: o.size || '', color: o.color || '',\n  qty, price, shipping_fee: ship, total: price * qty + ship,\n  payment: 'كاش عند الاستلام', notes: o.notes || '', fb_user_id: d.user_id, status: 'جديد'\n} }];"
      },
